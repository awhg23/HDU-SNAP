{
  "manifest_version": 3,
  "name": "HDU-SNAP Test Agent",
  "version": "1.0.0",
  "description": "HDU-SNAP 前端 Web 页面自动化 UI 测试代理",
  "minimum_chrome_version": "96",
  "permissions": [
    "tabs",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://skl.hdu.edu.cn/*",
    "https://skl.hduhelp.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://skl.hdu.edu.cn/*",
        "https://skl.hduhelp.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "HDU-SNAP Agent"
  }
}
